<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Upload Files</title>

<style>
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    background-color: #f4f6f9;
    color: #1f2933;
  }

  .page-wrapper {
    max-width: 800px;
    margin: 60px auto;
    padding: 0 20px;
  }

  .card {
    background: white;
    border-radius: 14px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    padding: 28px;
    margin-bottom: 30px;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-bar p {
    margin: 0;
    font-size: 14px;
    color: #52606d;
  }

  .home-btn {
    background: #1f2933;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.2s ease;
  }

  .home-btn:hover {
    background: #111827;
  }

  .section-title {
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 18px;
  }

  .guidelines {
    margin: 0;
    padding-left: 18px;
    color: #52606d;
    font-size: 14px;
  }

  .guidelines li {
    margin-bottom: 6px;
  }

  form {
    display: flex;
    flex-direction: column;
  }

  input[type="text"],
  input[type="file"] {
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    margin-bottom: 18px;
    font-size: 14px;
    transition: border 0.2s ease, box-shadow 0.2s ease;
  }

  input[type="file"] {
    padding: 8px;
  }

  input:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 2px rgba(37,99,235,0.15);
  }

  .primary-btn {
    background: #1f2933;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    transition: background 0.2s ease;
  }

  .primary-btn:hover {
    background: #111827;
  }

  @media (max-width: 600px) {
    .top-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
</head>

<body>

<div class="page-wrapper">

  <!-- Top Bar -->
  <div class="card top-bar">
    <div>
      <% if (currentUser) { %>
        <p>Currently logged in as <strong><%= currentUser.username %></strong></p>
      <% } else { %>
        <p>You are not logged in.</p>
      <% } %>
    </div>

    <button class="home-btn" onclick="window.location.href='/'">
      Return Home
    </button>
  </div>

  <!-- Guidelines -->
  <div class="card">
    <div class="section-title">Upload Guidelines</div>
    <ul class="guidelines">
      <li>The filename is required</li>
      <li>The password is optional</li>
      <li>You can upload multiple files</li>
    </ul>
  </div>

  <!-- Upload Form -->
  <div class="card">
    <div class="section-title">Create New Folder</div>

    <form action="/upload" enctype="multipart/form-data" method="post">
      <input type="text" placeholder="Folder name" name="name">
      <input type="text" placeholder="Optional password" name="password">
      <input type="file" name="uploaded_files" multiple>

      <button type="submit" class="primary-btn">
        Post New Folder
      </button>
    </form>
  </div>

</div>

</body>
</html>
